# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# PropAI API Configuration
# Next.js client code reads NEXT_PUBLIC_* vars.
# The Docker build also accepts legacy VITE_* names as a fallback for Coolify compatibility.
NEXT_PUBLIC_API_BASE_URL="https://api.propai.live/api"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
VITE_API_BASE_URL="https://api.propai.live/api"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_SERVICE_ROLE_KEY=""

# Meta App ID for WABA Embedded Signup (required for official WhatsApp connection)
NEXT_PUBLIC_META_APP_ID=""

# PostHog analytics (optional)
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"
