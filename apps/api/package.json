{
  "name": "backend",
  "version": "0.2.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "start": "node dist/index.js",
    "start:whatsapp-worker": "node dist/whatsapp-worker.js",
    "dev": "nodemon src/index.ts",
    "dev:whatsapp-worker": "nodemon src/whatsapp-worker.ts",
    "build": "tsc",
    "run:scraper:latest": "ts-node src/scripts/runGrasScraper.ts latest",
    "run:scraper:all": "ts-node src/scripts/runGrasScraper.ts all",
    "run:broker-lists": "ts-node src/scripts/buildBrokerListsFromExports.ts",
    "clean:locations": "ts-node src/scripts/cleanDbLocations.ts",
    "reparse:prices": "ts-node src/scripts/reparseDbPrices.ts",
    "stream:backfill:locality": "ts-node src/scripts/backfillStreamLocality.ts",
    "stream:backfill:buildings": "ts-node src/scripts/backfillBuildingNames.ts",
    "stream:backfill:fields": "ts-node src/scripts/backfillMissingFields.ts",
    "stream:backfill:canonical": "ts-node src/scripts/backfillCanonicalStreamItems.ts",
    "stream:backfill:saved": "ts-node src/scripts/rebuildSavedMessages.ts",
    "stream:cleanup": "ts-node src/scripts/cleanInvalidStreamItems.ts",
    "stream:cleanup:dry": "ts-node src/scripts/cleanInvalidStreamItems.ts --dry-run",
    "import:wadata": "ts-node src/scripts/importWhatsappExports.ts",
    "import:wadata:stream": "ts-node src/scripts/importWadataAcceptedToStream.ts",
    "import:wadata:full": "ts-node src/scripts/importWhatsappExports.ts && ts-node src/scripts/importWadataAcceptedToStream.ts && ts-node src/scripts/backfillCanonicalStreamItems.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@propai/price-parser": "workspace:*",
    "@hapi/boom": "^10.0.1",
    "@supabase/supabase-js": "^2.103.3",
    "@vishalgojha/whatsapp-baileys-runtime": "https://codeload.github.com/vishalgojha/whatsapp-baileys-runtime/tar.gz/5912f0d",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.15.0",
    "camoufox-js": "^0.8.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.58.0",
    "tesseract.js": "^5.1.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
